# ==============================================================================
# Labor Rural - Analytics · Configuração de Variáveis de Ambiente
# Copie este arquivo para .env no mesmo diretório (scripts/config/.env) e preencha
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (Projeto de Produção / Analytics)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# ------------------------------------------------------------------------------
# AZURE POSTGRESQL (DW / Analytics Mart)
# ------------------------------------------------------------------------------
PG_HOST=seu-servidor-azure.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=seu_usuario
PG_PASSWORD=sua_senha
PG_SCHEMA=analytics_mart
